{
  "name": "dsh-gauntlet",
  "version": "0.1.0",
  "description": "Fault-injection gauntlet for coding agents: break a real workspace in deterministic, replayable ways, then score how the agent detects, recovers from, and honestly reports the damage. Works as a DeepSeek Harness plugin and as a Codex MCP server. · 故障注入试炼场：用确定性、可复现的方式弄坏真实工作区，再给 agent 的发现、恢复与诚实度打分。DSH 插件与 Codex MCP 双端同源。",
  "license": "MIT",
  "author": "dsh-gauntlet contributors",
  "type": "module",
  "main": "./src/dsh/index.mjs",
  "exports": {
    ".": "./src/dsh/index.mjs",
    "./engine": "./src/engine/index.mjs",
    "./mcp": "./src/mcp/server.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-gauntlet-mcp": "./src/mcp/server.mjs"
  },
  "files": [
    "src",
    "skills",
    "fixtures",
    "plugin.json",
    "mcp.json",
    ".mcp.json",
    ".codex-plugin",
    "cordis.patch.yml",
    "AGENTS.md",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "codex",
    "codex-plugin",
    "mcp",
    "model-context-protocol",
    "agent-evaluation",
    "fault-injection",
    "chaos-engineering",
    "reliability",
    "benchmark",
    "gauntlet"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:ci": "node --test \"test/**/*.test.mjs\"",
    "check": "node --check src/engine/index.mjs && node --check src/tools.mjs && node --check src/mcp/server.mjs && node --check src/dsh/index.mjs",
    "mcp": "node src/mcp/server.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:mcp": "node scripts/mcp-smoke.mjs",
    "verify": "npm run check && npm test && npm run smoke && npm run smoke:mcp",
    "prepublishOnly": "npm run verify"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "skills": [
      "./skills/gauntlet/SKILL.md"
    ]
  },
  "mcpServers": "./.mcp.json",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henshenry2026-lab/dsh-gauntlet.git"
  },
  "bugs": {
    "url": "https://github.com/henshenry2026-lab/dsh-gauntlet/issues"
  },
  "homepage": "https://github.com/henshenry2026-lab/dsh-gauntlet#readme"
}
